<Page
    x:Class="HandheldCompanion.Views.QuickPages.QuickProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:l="clr-namespace:HandheldCompanion.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:HandheldCompanion.Properties"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodels="clr-namespace:HandheldCompanion.ViewModels"
    Name="QuickProfiles"
    Title="{l:Static resx:Resources.QuickProfilesPage_Title}"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodels:ProfilesPageViewModel}"
    d:DesignHeight="2200"
    d:DesignWidth="640"
    KeepAlive="True"
    mc:Ignorable="d">

    <Page.Resources>
        <ui:ContentDialog
            x:Key="CreatePowerProfileDialog"
            x:Name="CreateProfileContentDialog"
            Title="Create New Power Profile"
            DefaultButton="Primary"
            PrimaryButtonText="Create"
            SecondaryButtonText="Cancel">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Text="Profile Name:" />

                <TextBox
                    x:Name="ProfileNameTextBox"
                    Grid.Row="1"
                    Margin="0,0,0,16"
                    Text="{Binding CreateProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    x:Name="CopyDefaultCheckBox"
                    Grid.Row="2"
                    Content="Copy default profile settings (including fan curves)"
                    IsChecked="{Binding CopyDefaultProfileSettings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </ui:ContentDialog>
    </Page.Resources>

    <ikw:SimpleStackPanel IsEnabled="{Binding HasSelectedProfile, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Spacing="28">

        <ikw:SimpleStackPanel Spacing="3">
            <Border
                Height="70"
                d:Visibility="Collapsed"
                CornerRadius="3"
                Visibility="{Binding Artwork, Converter={StaticResource HasArtworkConverter}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Artwork, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <!--  Header  -->
            <ui:SettingsExpander
                Name="ProcessCard"
                d:IsExpanded="True"
                IsEnabled="{Binding IsProcessCardEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:SettingsExpander.HeaderIcon>
                    <Image
                        Name="ProfileIcon"
                        Grid.Column="0"
                        Width="24"
                        Height="24"
                        Source="{Binding ProcessIcon, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingsExpander.HeaderIcon>

                <ui:SettingsExpander.Header>
                    <TextBlock
                        Name="ProcessName"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{Binding ProcessName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                </ui:SettingsExpander.Header>

                <ui:SettingsExpander.Description>
                    <TextBlock
                        Name="ProcessPath"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding ProcessPath, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="NoWrap"
                        Visibility="{Binding IsProcessPathVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </ui:SettingsExpander.Description>

                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Header="{l:Static resx:Resources.ProfilesPage_EnableProfile}">
                        <ui:SettingsCard.Description>
                            <TextBlock
                                Name="CurrentProfileName"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding CurrentProfileName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="NoWrap" />
                        </ui:SettingsCard.Description>

                        <ui:ToggleSwitch Name="ProfileToggle" IsOn="{Binding ProfileEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ui:SettingsCard>

                    <!--  Sub Profiles  -->
                    <ui:SettingsCard
                        Name="SubProfilesBorder"
                        d:Visibility="Visible"
                        Description="{l:Static resx:Resources.QuickProfilesPage_SubProfilesDesc}"
                        Header="{l:Static resx:Resources.ProfilesPage_SubProfiles}"
                        Visibility="{Binding IsSubProfilesVisible, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <ui:SettingsCard.Resources>
                            <sys:Double x:Key="SettingsCardWrapThreshold">476</sys:Double>
                            <sys:Double x:Key="SettingsCardWrapNoIconThreshold">286</sys:Double>
                        </ui:SettingsCard.Resources>

                        <ComboBox
                            Name="SelectSubProfileComboBox"
                            MaxWidth="{Binding ActualWidth, ConverterParameter=x/2.4, Converter={StaticResource Math}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsCard}}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding SubProfilesView, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedSubProfileViewModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ui:SettingsCard>

                    <ui:SettingsCard
                        Command="{Binding OpenProfilePageCommand}"
                        Header="{l:Static resx:Resources.ProfilesPage_OpenProfilePage}"
                        IsClickEnabled="True"
                        Tag="Navigation" />

                    <ui:SettingsCard
                        Command="{Binding OpenProfileLayoutCommand}"
                        Header="{l:Static resx:Resources.ProfilesPage_OpenLayoutPage}"
                        IsClickEnabled="True"
                        Tag="Navigation" />
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>
        </ikw:SimpleStackPanel>

        <ikw:SimpleStackPanel Name="GridProfile" Spacing="28">

            <!--  Performance settings  -->
            <ikw:SimpleStackPanel Spacing="8">
                <TextBlock
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{l:Static resx:Resources.ProfilesPage_PerformanceSettings}"
                    Visibility="{Binding ShowPowerSlots, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  the power slots also hold the graphics settings, the power preset needs the performance manager  -->
                <ikw:SimpleStackPanel Spacing="3" Visibility="{Binding ShowPowerSlots, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SettingsExpander Header="{l:Static resx:Resources.PowerState_PluggedIn}" IsExpanded="False">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Glyph="&#xec4a;" />
                        </ui:SettingsExpander.HeaderIcon>

                        <TextBlock
                            MaxWidth="{Binding ActualWidth, ConverterParameter=x/2.4, Converter={StaticResource Math}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsExpander}}"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{Binding SelectedPickerAC.Text, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ResourceStringFormatConverter}, ConverterParameter=ProfilesPage_PowerProfileSummary}"
                            Visibility="{Binding PerformanceManagerEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard
                                Command="{Binding OpenPowerProfilePluggedCommand}"
                                Header="{l:Static resx:Resources.ProfilesPage_PowerPreset}"
                                IsClickEnabled="True"
                                Tag="Navigation"
                                Visibility="{Binding PerformanceManagerEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ComboBox
                                    Name="PowerProfilePlugged"
                                    MaxWidth="{Binding ActualWidth, ConverterParameter=x/2, Converter={StaticResource Math}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsCard}}"
                                    DisplayMemberPath="Text"
                                    ItemContainerStyle="{StaticResource {x:Type ComboBoxItem}}"
                                    ItemsSource="{Binding ProfilePickerCollectionViewAC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedPickerAC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Text">
                                    <ComboBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        Style="{StaticResource BaseTextBlockStyle}"
                                                        Text="{Binding Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ComboBox.GroupStyle>
                                </ComboBox>
                            </ui:SettingsCard>

                            <!--  overridden: the row expands to its value rows, which keep the same left edge; a fixed padding keeps the clickable item style from moving the combo  -->
                            <ui:SettingsCard
                                Padding="{DynamicResource SettingsExpanderItemPadding}"
                                Command="{Binding ToggleFramerateExpandedACCommand}"
                                Description="{Binding FramerateHintAC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                Header="{l:Static resx:Resources.ProfilesPage_FramerateLimit}"
                                IsActionIconVisible="False"
                                IsClickEnabled="{Binding IsFramerateOverrideAC, Mode=OneWay}">
                                <!--  the chevron sits in the right padding, where a clickable row has its action icon, so the combo does not move  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFramerateOverrideAC, Mode=OneWay}" Value="True">
                                                    <Setter Property="Margin" Value="0,0,-28,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ComboBox
                                        MinWidth="140"
                                        ItemsSource="{Binding FramerateModeOptions, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        DisplayMemberPath="Label"
                                        SelectedValue="{Binding FramerateModeAC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Mode" />
                                    <Border Width="28" Visibility="{Binding IsFramerateOverrideAC, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:FontIcon
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Glyph="{Binding FramerateChevronAC, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{l:Static resx:Resources.QuickPerformancePage_AutoTDPUnitFPS}" Visibility="{Binding ShowFramerateValueAC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ComboBox
                                    MinWidth="140"
                                    ItemsSource="{Binding FramerateLimitsAC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValue="{Binding SelectedFrameLimitKeyAC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="SelectionKey" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Visibility="{Binding ShowFramerateCustomAC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsCard}}">
                                    <Label
                                        VerticalAlignment="Center"
                                        Content="{Binding FramerateCustomValueAC, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                        ContentStringFormat="{}{0:N0} FPS"
                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <Slider
                                        Margin="8,0,104,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        AutoToolTipPrecision="0"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="{Binding FramerateCustomMaximumAC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="{Binding FramerateCustomMinimum, Mode=OneWay}"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        TickPlacement="BottomRight"
                                        ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                        Value="{Binding FramerateCustomValueAC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </ui:SettingsCard>

                            <!--  resolution and refresh rate overrides, one row per connected monitor; a local style keeps the expander item style off  -->
                            <ikw:SimpleStackPanel Style="{x:Null}">
                                <ItemsControl
                                    Focusable="False"
                                    ItemTemplate="{StaticResource DisplayOverrideRowTemplate}"
                                    ItemsSource="{Binding DisplayOverrideRowsAC, Mode=OneWay}"
                                    Style="{x:Null}" />
                            </ikw:SimpleStackPanel>

                            <!--  graphics overrides, one row per graphics group  -->
                            <ikw:SimpleStackPanel Style="{x:Null}" Visibility="{Binding GPUManagementEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl
                                    Focusable="False"
                                    ItemTemplate="{StaticResource GraphicsOverrideRowTemplate}"
                                    ItemsSource="{Binding GraphicsOverrideRowsAC, Mode=OneWay}"
                                    Style="{x:Null}" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>
                    <ui:SettingsExpander Header="{l:Static resx:Resources.PowerState_OnBattery}" IsExpanded="False">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Glyph="&#xebb2;" />
                        </ui:SettingsExpander.HeaderIcon>

                        <TextBlock
                            MaxWidth="{Binding ActualWidth, ConverterParameter=x/2.4, Converter={StaticResource Math}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsExpander}}"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{Binding SelectedPickerDC.Text, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ResourceStringFormatConverter}, ConverterParameter=ProfilesPage_PowerProfileSummary}"
                            Visibility="{Binding PerformanceManagerEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard
                                Command="{Binding OpenPowerProfileOnBatteryCommand}"
                                Header="{l:Static resx:Resources.ProfilesPage_PowerPreset}"
                                IsClickEnabled="True"
                                Tag="Navigation"
                                Visibility="{Binding PerformanceManagerEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ComboBox
                                    Name="PowerProfileOnBattery"
                                    MaxWidth="{Binding ActualWidth, ConverterParameter=x/2, Converter={StaticResource Math}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsCard}}"
                                    DisplayMemberPath="Text"
                                    ItemContainerStyle="{StaticResource {x:Type ComboBoxItem}}"
                                    ItemsSource="{Binding ProfilePickerCollectionViewDC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedPickerDC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Text">
                                    <ComboBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        Style="{StaticResource BaseTextBlockStyle}"
                                                        Text="{Binding Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ComboBox.GroupStyle>
                                </ComboBox>
                            </ui:SettingsCard>

                            <!--  overridden: the row expands to its value rows, which keep the same left edge; a fixed padding keeps the clickable item style from moving the combo  -->
                            <ui:SettingsCard
                                Padding="{DynamicResource SettingsExpanderItemPadding}"
                                Command="{Binding ToggleFramerateExpandedDCCommand}"
                                Description="{Binding FramerateHintDC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                Header="{l:Static resx:Resources.ProfilesPage_FramerateLimit}"
                                IsActionIconVisible="False"
                                IsClickEnabled="{Binding IsFramerateOverrideDC, Mode=OneWay}">
                                <!--  the chevron sits in the right padding, where a clickable row has its action icon, so the combo does not move  -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFramerateOverrideDC, Mode=OneWay}" Value="True">
                                                    <Setter Property="Margin" Value="0,0,-28,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ComboBox
                                        MinWidth="140"
                                        ItemsSource="{Binding FramerateModeOptions, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        DisplayMemberPath="Label"
                                        SelectedValue="{Binding FramerateModeDC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Mode" />
                                    <Border Width="28" Visibility="{Binding IsFramerateOverrideDC, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:FontIcon
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Glyph="{Binding FramerateChevronDC, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{l:Static resx:Resources.QuickPerformancePage_AutoTDPUnitFPS}" Visibility="{Binding ShowFramerateValueDC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ComboBox
                                    MinWidth="140"
                                    ItemsSource="{Binding FramerateLimitsDC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValue="{Binding SelectedFrameLimitKeyDC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="SelectionKey" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Visibility="{Binding ShowFramerateCustomDC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ui:SettingsCard}}">
                                    <Label
                                        VerticalAlignment="Center"
                                        Content="{Binding FramerateCustomValueDC, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                        ContentStringFormat="{}{0:N0} FPS"
                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <Slider
                                        Margin="8,0,104,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        AutoToolTipPrecision="0"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="{Binding FramerateCustomMaximumDC, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="{Binding FramerateCustomMinimum, Mode=OneWay}"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        TickPlacement="BottomRight"
                                        ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                        Value="{Binding FramerateCustomValueDC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </ui:SettingsCard>

                            <!--  resolution and refresh rate overrides, one row per connected monitor; a local style keeps the expander item style off  -->
                            <ikw:SimpleStackPanel Style="{x:Null}">
                                <ItemsControl
                                    Focusable="False"
                                    ItemTemplate="{StaticResource DisplayOverrideRowTemplate}"
                                    ItemsSource="{Binding DisplayOverrideRowsDC, Mode=OneWay}"
                                    Style="{x:Null}" />
                            </ikw:SimpleStackPanel>

                            <!--  graphics overrides, one row per graphics group  -->
                            <ikw:SimpleStackPanel Style="{x:Null}" Visibility="{Binding GPUManagementEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl
                                    Focusable="False"
                                    ItemTemplate="{StaticResource GraphicsOverrideRowTemplate}"
                                    ItemsSource="{Binding GraphicsOverrideRowsDC, Mode=OneWay}"
                                    Style="{x:Null}" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>
                    <ui:SettingsCard
                        Name="CreatePowerProfileCard"
                        Header="{l:Static resx:Resources.ProfilesPage_CreatePowerProfile}"
                        IsClickEnabled="True"
                        Tag="Navigation" />
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>

            <!--  Motion control settings  -->
            <ikw:SimpleStackPanel Spacing="8">
                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{l:Static resx:Resources.ProfilesPage_InputsSettings}" />

                <ui:SettingsExpander
                    d:IsExpanded="true"
                    Description="{l:Static resx:Resources.ProfilesPage_MotionControlSettingsDesc}"
                    Header="{l:Static resx:Resources.ProfilesPage_MotionControlSettings}"
                    IsExpanded="False">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Glyph="&#xE8B4;" />
                    </ui:SettingsExpander.HeaderIcon>

                    <TextBlock
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{Binding OutputMode, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MotionOutputToNameConverter}}" />

                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Description="{l:Static resx:Resources.ProfilesPage_UMCSelectionRightLeftDesc}" Header="{l:Static resx:Resources.ProfilesPage_StyleofOutput}">
                            <ComboBox
                                Name="MotionOutputComboBox"
                                ItemsSource="{Binding MotionOutputModes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValue="{Binding OutputMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntToMotionOutputConverter}}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <ikw:SimpleStackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <ui:FontIcon Glyph="{Binding Glyph}" Visibility="{Binding HasGlyph, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding Description}" />
                                        </ikw:SimpleStackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard
                            Description="{l:Static resx:Resources.ProfilesPage_StyleofInputTooltip}"
                            Header="{l:Static resx:Resources.ProfilesPage_StyleofInput}"
                            Visibility="{Binding OutputMode, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1|2|3|4|5|6}">
                            <ComboBox
                                Name="MotionInputComboBox"
                                ItemsSource="{Binding MotionInputModes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValue="{Binding InputMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntToMotionInputConverter}}"
                                SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <ikw:SimpleStackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <ui:FontIcon Glyph="{Binding Glyph}" Visibility="{Binding HasGlyph, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding Description}" />
                                        </ikw:SimpleStackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Static resx:Resources.ProfilesPage_UMCMotionOnOff}" Visibility="{Binding OutputMode, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1|2|3|4|5|6}">

                            <ui:SettingsCard.Resources>
                                <sys:Double x:Key="SettingsCardWrapThreshold">476</sys:Double>
                                <sys:Double x:Key="SettingsCardWrapNoIconThreshold">286</sys:Double>
                            </ui:SettingsCard.Resources>

                            <ikw:SimpleStackPanel Spacing="3">
                                <ComboBox
                                    Name="MotionModeComboBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="{Binding MotionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="{l:Static resx:Resources.ProfilesPage_UMCMotionOff}" />
                                    <ComboBoxItem Content="{l:Static resx:Resources.ProfilesPage_UMCMotionOn}" />
                                    <ComboBoxItem Content="{l:Static resx:Resources.ProfilesPage_UMCMotionToggle}" />
                                </ComboBox>

                                <ItemsControl ItemsSource="{Binding HotkeysList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MaxWidth="50" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition MinWidth="90" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Padding="6"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{DynamicResource ExpanderHeaderBackground}"
                                                    CornerRadius="3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTriggerChord}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding InputsChordType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Border>

                                                <ItemsControl
                                                    Grid.Column="1"
                                                    Margin="3,0,0,0"
                                                    ItemsSource="{Binding TriggerChordParts}">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTriggerChord}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExecuted}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation
                                                                                    AutoReverse="True"
                                                                                    FillBehavior="Stop"
                                                                                    RepeatBehavior="1x"
                                                                                    Storyboard.TargetProperty="Opacity"
                                                                                    From="1.0"
                                                                                    To="0.0"
                                                                                    Duration="0:0:0.125" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>

                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                MinWidth="40"
                                                                HorizontalAlignment="Stretch"
                                                                Background="{DynamicResource AccentAAFillColorDefaultBrush}"
                                                                CornerRadius="3">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="{Binding FontFamily, FallbackValue={StaticResource SymbolThemeFontFamily}, TargetNullValue={StaticResource SymbolThemeFontFamily}}"
                                                                    FontSize="{Binding FontSize}"
                                                                    Foreground="{Binding Color, Converter={StaticResource ColorToBrushConverter}, FallbackValue={StaticResource SystemControlForegroundAltHighBrush}}"
                                                                    Text="{Binding Glyph}"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="NoWrap" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ikw:SimpleStackPanel
                                                    Grid.Column="2"
                                                    Height="40"
                                                    Margin="12,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="3">

                                                    <ToggleButton
                                                        VerticalAlignment="Stretch"
                                                        Command="{Binding DefineButtonCommand}"
                                                        IsChecked="{Binding IsListening, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Tag="Hotkey">
                                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xe104;" />
                                                    </ToggleButton>

                                                    <Button VerticalAlignment="Stretch" Command="{Binding EraseButtonCommand}">
                                                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xe75c;" />
                                                    </Button>
                                                </ikw:SimpleStackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard
                            Description="{l:Static resx:Resources.ProfilesPage_UMCAntiDeadzoneDesc}"
                            Header="{l:Static resx:Resources.ProfilesPage_UMCAntiDeadzone}"
                            Visibility="{Binding OutputMode, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1|2}">
                            <ui:SettingsCard.Resources>
                                <sys:Double x:Key="SettingsCardWrapThreshold">476</sys:Double>
                                <sys:Double x:Key="SettingsCardWrapNoIconThreshold">286</sys:Double>
                            </ui:SettingsCard.Resources>
                            <DockPanel>
                                <TextBox
                                    Height="31"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding AntiDeadzoneValue, StringFormat={}{0:N0}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Slider
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutoToolTipPrecision="0"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="40"
                                    SmallChange="1"
                                    TickPlacement="BottomRight"
                                    ToolTip="{Binding Value, StringFormat=N0, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    Value="{Binding AntiDeadzoneValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </ui:SettingsCard>

                        <!--  Gyrometer weight  -->
                        <ui:SettingsCard
                            Description="Adjusts how strongly gyroscope movement is mixed with existing input"
                            Header="Gyrometer weight"
                            Visibility="{Binding OutputMode, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1|2|3|4|5|6}">
                            <ui:SettingsCard.Resources>
                                <sys:Double x:Key="SettingsCardWrapThreshold">476</sys:Double>
                                <sys:Double x:Key="SettingsCardWrapNoIconThreshold">286</sys:Double>
                            </ui:SettingsCard.Resources>
                            <DockPanel>
                                <TextBox
                                    Height="31"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding GyroWeightValue, StringFormat={}{0:N1}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Slider
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutoToolTipPrecision="1"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    Maximum="2.0"
                                    Minimum="1.0"
                                    TickFrequency="0.1"
                                    TickPlacement="BottomRight"
                                    ToolTip="{Binding Value, StringFormat=N1, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    Value="{Binding GyroWeightValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </ui:SettingsCard>

                        <!--  Horizontal sensitivity  -->
                        <ui:SettingsCard Header="Horizontal sensitivity" Visibility="{Binding OutputMode, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1|2|3|4|5|6}">
                            <ui:SettingsCard.Resources>
                                <sys:Double x:Key="SettingsCardWrapThreshold">476</sys:Double>
                                <sys:Double x:Key="SettingsCardWrapNoIconThreshold">286</sys:Double>
                            </ui:SettingsCard.Resources>
                            <DockPanel>
                                <TextBox
                                    Height="31"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding SensitivityXValue, StringFormat={}{0:N1}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Slider
                                    x:Name="SensitivityXValue"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutoToolTipPrecision="1"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="0.1"
                                    Maximum="3.0"
                                    Minimum="0.1"
                                    SmallChange="0.1"
                                    TickFrequency="0.1"
                                    TickPlacement="BottomRight"
                                    ToolTip="{Binding Value, StringFormat=N1, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    Value="{Binding SensitivityXValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </ui:SettingsCard>

                        <!--  Vertical sensitivity  -->
                        <ui:SettingsCard Header="Vertical sensitivity" Visibility="{Binding OutputMode, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1|2|3|4|5|6}">
                            <ui:SettingsCard.Resources>
                                <sys:Double x:Key="SettingsCardWrapThreshold">476</sys:Double>
                                <sys:Double x:Key="SettingsCardWrapNoIconThreshold">286</sys:Double>
                            </ui:SettingsCard.Resources>
                            <DockPanel>
                                <TextBox
                                    Height="31"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding SensitivityYValue, StringFormat={}{0:N1}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Slider
                                    x:Name="SliderSensitivityY"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutoToolTipPrecision="1"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="0.1"
                                    Maximum="3.0"
                                    Minimum="0.1"
                                    SmallChange="0.1"
                                    TickFrequency="0.1"
                                    TickPlacement="BottomRight"
                                    ToolTip="{Binding Value, StringFormat=N1, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                    Value="{Binding SensitivityYValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </ikw:SimpleStackPanel>

            <!--  Graphics settings  -->
            <ikw:SimpleStackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{l:Static resx:Resources.ProfilesPage_GraphicsSettings}" />

                <ui:SettingsExpander
                    Name="GraphicsSettingsExpander"
                    d:IsExpanded="true"
                    Description="{l:Static resx:Resources.ProfilesPage_GraphicsSettingsDesc}"
                    Header="{l:Static resx:Resources.ProfilesPage_GraphicsSettings}"
                    Visibility="{Binding GPUManagementEnabled, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                    </ui:SettingsExpander.HeaderIcon>

                    <ui:SettingsExpander.Items>
                        <!--  Pre-built shader download  -->
                        <ui:SettingsCard
                            Description="Download pre-built shaders for this application."
                            Header="Pre-built Shader Download"
                            IsEnabled="{Binding HasPrebuiltShaderDownload, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">

                            <ui:ToggleSwitch IsOn="{Binding PrebuiltShaderDownloadEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
            </ikw:SimpleStackPanel>
        </ikw:SimpleStackPanel>
    </ikw:SimpleStackPanel>
</Page>
